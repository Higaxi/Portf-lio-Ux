# Copie para .env.local (nunca faça commit do .env.local).

# URL pública do site, usada em sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Envio do formulário de contato pelo Resend (https://resend.com).
# Sem RESEND_API_KEY o formulário continua funcionando, mas responde que o
# envio ainda não está ativo e mostra o e-mail para contato direto.
RESEND_API_KEY=
# Para onde as mensagens vão.
CONTACT_TO_EMAIL=
# Remetente verificado no Resend. Enquanto não verificar um domínio, use:
CONTACT_FROM_EMAIL="Portfólio <onboarding@resend.dev>"
